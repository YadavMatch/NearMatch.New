# Copy this file to .env.local and replace placeholders with Firebase web-app config.
# These VITE_ values are bundled into the browser; never put service-account keys,
# private keys, or other privileged credentials here.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional values
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Optional server-side/runtime values used by AI Studio integrations.
# Keep private API keys in the host's secret manager, not in VITE_ variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
APP_URL=http://localhost:3000
